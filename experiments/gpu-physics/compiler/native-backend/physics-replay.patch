+/// Isolated native physics replay: owns the original pool, commands and resources.
+/// Only Vulkan, buffer-only, reusable-flag recordings are supported.
+pub struct NativePhysicsReplay {
+    data: CommandBufferMutable,
+    device: Arc<Device>,
+}
+impl Global {
+    /// Caller must have recorded every Vulkan primary with SIMULTANEOUS_USE.
+    pub unsafe fn native_physics_capture(&self,id:id::CommandBufferId)->Arc<NativePhysicsReplay> {
+        let command=self.hub.command_buffers.get(id);
+        let data=command.take_finished().expect("finished native physics buffer");
+        assert!(data.trackers.textures.used_resources().next().is_none(),"buffer-only physics capture");
+        assert!(data.as_actions.is_empty(),"no acceleration-structure actions");
+        Arc::new(NativePhysicsReplay{data,device:command.device.clone()})
+    }
+    /// Replays only on the recording's device. Caller must invalidate on changes
+    /// to resource identity, dispatch layout or native command configuration.
+    pub unsafe fn native_physics_replay(&self,id:id::CommandEncoderId,owner:Arc<NativePhysicsReplay>) {
+        let command=self.hub.command_buffers.get(id.into_command_buffer_id());
+        assert!(Arc::ptr_eq(&command.device,&owner.device));
+        let handles:Vec<_>=owner.data.encoder.list.iter().flat_map(|b|unsafe{
+            b.as_any().downcast_ref::<hal::vulkan::CommandBuffer>().expect("Vulkan capture").cache_raw_handles()
+        }).collect();
+        let mut state=command.data.lock();
+        state.record_as_hal_mut(|inner| {
+            let inner=inner.expect("recording replay target");
+            let guard=command.device.snatchable_lock.read();
+            for buffer in owner.data.trackers.buffers.used_resources(){buffer.check_destroyed(&guard).expect("live replay buffer");}
+            inner.buffer_memory_init_actions.extend(owner.data.buffer_memory_init_actions.iter().cloned());
+            let raw=inner.encoder.open().expect("replay prefix");
+            CommandBuffer::insert_barriers_from_tracker(raw,&mut inner.trackers,&owner.data.trackers,&guard);
+            unsafe {raw.as_any_mut().downcast_mut::<hal::vulkan::CommandEncoder>().expect("Vulkan target")
+                .cache_insert_primary_list(&handles,owner.clone()).expect("insert tracked replay");}
+        });
+    }
+}

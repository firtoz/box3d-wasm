  "candidate_patch": "--- a/shaders/physics/solve.wgsl\n+++ b/shaders/physics/solve.wgsl\n@@ -1698,10 +1698,14 @@\n ) {\n     let base_frame_a = quat_mul((*ba).rot, (*jn).frame_a_rotation);\n     let base_frame_b = quat_mul((*bb).rot, (*jn).frame_b_rotation);\n-    let cone_axis = quat_rotate(base_frame_a, vec3<f32>(0.0, 0.0, 1.0));\n-    let twist_axis = quat_rotate(base_frame_b, vec3<f32>(0.0, 0.0, 1.0));\n+    // Bounded experiment: relinearize both angular-limit rows together.\n+    let refresh_angular_frames = (params.diagnostic_flags & SOLVER_PAIRED_NORMALS) != 0u;\n+    let angular_frame_a = select(base_frame_a, quat_mul((*ba).dq, base_frame_a), refresh_angular_frames);\n+    let angular_frame_b = select(base_frame_b, quat_mul((*bb).dq, base_frame_b), refresh_angular_frames);\n+    let cone_axis = quat_rotate(angular_frame_a, vec3<f32>(0.0, 0.0, 1.0));\n+    let twist_axis = quat_rotate(angular_frame_b, vec3<f32>(0.0, 0.0, 1.0));\n     let swing_axis = gyro_norm3(gyro_cross(cone_axis, twist_axis));\n-    let base_rel = quat_mul(quat_inv(base_frame_a), base_frame_b);\n+    let base_rel = quat_mul(quat_inv(angular_frame_a), angular_frame_b);\n     let tangent_denominator = base_rel.z * base_rel.z + base_rel.w * base_rel.w;\n     let tan_half_swing = select(\n         0.0,\n@@ -1835,6 +1839,64 @@\n             + applied_upper * world_inv_inertia(*ba, twist_jacobian);\n         (*bb).omega = (*bb).omega\n             - applied_upper * world_inv_inertia(*bb, twist_jacobian);\n+    }\n+\n+    // Bounded artifact-only candidate: solve point and cone rows as a block.\n+    // Scalar/vector softness is preserved through its equivalent Gamma matrix.\n+    if (refresh_angular_frames && ((*jn).flags & SPHERICAL_ENABLE_CONE_LIMIT) != 0u\n+        && !fixed_rotation && swing_k > 0.0) {\n+        let soft = joint_softness((*jn).hertz, (*jn).damping);\n+        let cone_c = (*jn).target_translation - swing_angle(rel);\n+        var cone_bias = 0.0;\n+        var cone_mass_scale = 1.0;\n+        var cone_impulse_scale = 0.0;\n+        if (cone_c > 0.0) {\n+            cone_bias = cone_c / max(params.dt, 1e-8);\n+        } else if (params.use_bias == 1u) {\n+            cone_bias = soft.x * cone_c;\n+            cone_mass_scale = soft.y;\n+            cone_impulse_scale = soft.z;\n+        }\n+        var point_bias = vec3<f32>(0.0);\n+        var point_mass_scale = 1.0;\n+        var point_impulse_scale = 0.0;\n+        if (params.use_bias == 1u) {\n+            let separation = (((*bb).dp - (*ba).dp) + (rB - rA))\n+                + ((*bb).pos - (*ba).pos);\n+            point_bias = soft.x * separation;\n+            point_mass_scale = soft.y;\n+            point_impulse_scale = soft.z;\n+        }\n+        let coupling = gyro_cross(rA, world_inv_inertia(*ba, swing_axis))\n+            + gyro_cross(rB, world_inv_inertia(*bb, swing_axis));\n+        let inverse_point_coupling = point_mass_scale\n+            * motor_linear_mass_mul(*ba, *bb, rA, rB, coupling);\n+        let cone_diagonal = gyro_divide(swing_k, cone_mass_scale);\n+        let schur = cone_diagonal - gyro_dot3(coupling, inverse_point_coupling);\n+        // Near-singular blocks retain the original sequential fallback.\n+        if (schur > 1e-6 * cone_diagonal) {\n+            let point_cdot = joint_point_velocity(\n+                (*ba).vel, (*ba).omega, (*bb).vel, (*bb).omega, rA, rB);\n+            let free_point_delta = -point_mass_scale\n+                * motor_linear_mass_mul(*ba, *bb, rA, rB, point_cdot + point_bias)\n+                - point_impulse_scale * (*jn).angular_impulse;\n+            let cone_cdot = spherical_cone_velocity((*ba).omega, (*bb).omega, swing_axis);\n+            let old_cone = (*jn).swing_impulse;\n+            let cone_rhs = -(cone_cdot + cone_bias)\n+                - cone_impulse_scale * cone_diagonal * old_cone;\n+            let free_cone_delta = gyro_divide(\n+                cone_rhs - gyro_dot3(coupling, free_point_delta), schur);\n+            let new_cone = max(old_cone + free_cone_delta, 0.0);\n+            let cone_delta = new_cone - old_cone;\n+            let point_delta = free_point_delta - inverse_point_coupling * cone_delta;\n+            (*jn).swing_impulse = new_cone;\n+            (*jn).angular_impulse = (*jn).angular_impulse + point_delta;\n+            apply_P(ba, rA, point_delta, -1.0);\n+            apply_P(bb, rB, point_delta, 1.0);\n+            (*ba).omega = (*ba).omega + cone_delta * world_inv_inertia(*ba, swing_axis);\n+            (*bb).omega = (*bb).omega - cone_delta * world_inv_inertia(*bb, swing_axis);\n+            return;\n+        }\n     }\n \n     if (((*jn).flags & SPHERICAL_ENABLE_CONE_LIMIT) != 0u && !fixed_rotation) {\n",

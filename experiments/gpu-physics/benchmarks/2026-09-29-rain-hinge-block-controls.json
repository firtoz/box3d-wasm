  "sources": {
    "check.py": "from pathlib import Path\nimport numpy as np,json\np=Path(__file__).resolve().parent;rng=np.random.default_rng(290932);rows=[]\ndef S(r):\n x,y,z=r;return np.array([[0,-z,y],[z,0,-x],[-y,x,0]])\nfor case in range(96):\n ia,ib=[(lambda a:a@a.T+np.eye(3))(rng.normal(size=(3,3))) for _ in range(2)]\n ra,rb=rng.normal(size=(2,3));ma,mb=rng.uniform(.1,2,2);Q,_=np.linalg.qr(rng.normal(size=(3,3)));A=.5*Q[:,:2]\n Kp=(ma+mb)*np.eye(3)-S(ra)@ia@S(ra)-S(rb)@ib@S(rb);Ka=A.T@(ia+ib)@A;C=-(S(ra)@ia+S(rb)@ib)@A\n ms=1. if case%3==0 else rng.uniform(.01,.99);ips=1-ms;gamma=ips/ms\n lp,la=rng.normal(size=3),rng.normal(size=2);vp,va=rng.normal(size=3),rng.normal(size=2);bp,ba=rng.normal(size=3),rng.normal(size=2)\n Hp=Kp/ms;Ha=Ka/ms;rp=vp+bp+gamma*Kp@lp;rr=va+ba+gamma*Ka@la\n q=ms*np.linalg.solve(Kp,vp+bp)+ips*lp;U=ms*np.linalg.solve(Kp,C);Schur=Ha-C.T@U;da=-np.linalg.solve(Schur,rr-C.T@q);dp=-q-U@da\n H=np.block([[Hp,C],[C.T,Ha]]);rhs=np.r_[rp,rr];full=-np.linalg.solve(H,rhs);schur=np.r_[dp,da]\n error=np.linalg.norm(full-schur)/(1+np.linalg.norm(full));residual=np.linalg.norm(H@schur+rhs)/(1+np.linalg.norm(rhs));assert error<1e-11 and residual<1e-11\n # Decoupled point/rotation limit retains each original softened update.\n independent=-np.r_[ms*np.linalg.solve(Kp,vp+bp)+ips*lp,ms*np.linalg.solve(Ka,va+ba)+ips*la]\n ref=-np.linalg.solve(np.block([[Hp,np.zeros((3,2))],[np.zeros((2,3)),Ha]]),rhs);assert np.max(abs(ref-independent))<1e-11\n # Physical hard, zero-bias projection removes kinetic energy and conserves momentum.\n if case%3==0:\n  va0,vb0,wa0,wb0=rng.normal(size=(4,3));vv=vb0+np.cross(wb0,rb)-va0-np.cross(wa0,ra);ww=A.T@(wb0-wa0);K=np.block([[Kp,C],[C.T,Ka]]);delta=-np.linalg.solve(K,np.r_[vv,ww]);P=delta[:3];T=A@delta[3:];va1=va0-ma*P;vb1=vb0+mb*P;wa1=wa0-ia@(np.cross(ra,P)+T);wb1=wb0+ib@(np.cross(rb,P)+T)\n  energy=lambda a,b,c,d:.5*(a@a/ma+b@b/mb+c@np.linalg.solve(ia,c)+d@np.linalg.solve(ib,d))\n  gain=energy(va1,vb1,wa1,wb1)-energy(va0,vb0,wa0,wb0);assert gain<1e-10\n  linear=np.linalg.norm((va1-va0)/ma+(vb1-vb0)/mb)\n  angular=np.linalg.norm(np.cross(-ra,(va1-va0)/ma)+np.cross(-rb,(vb1-vb0)/mb)+np.linalg.solve(ia,wa1-wa0)+np.linalg.solve(ib,wb1-wb0));assert max(linear,angular)<1e-10\n else:gain=linear=angular=None\n rows.append(dict(case=case,relative_solution_error=float(error),relative_residual=float(residual),energy_gain=None if gain is None else float(gain),linear_momentum_error=None if linear is None else float(linear),angular_momentum_error=None if angular is None else float(angular)))\nresult={'cases':96,'max_relative_solution_error':max(r['relative_solution_error'] for r in rows),'max_relative_residual':max(r['relative_residual'] for r in rows),'hard_projection_cases':32,'max_hard_energy_gain':max(r['energy_gain'] for r in rows if r['energy_gain'] is not None),'max_momentum_error':max(max(r['linear_momentum_error'],r['angular_momentum_error']) for r in rows if r['linear_momentum_error'] is not None),'rows':rows}\n(p/'result.json').write_text(json.dumps(result,indent=2));print(json.dumps({k:v for k,v in result.items() if k!='rows'}))\n"
  },

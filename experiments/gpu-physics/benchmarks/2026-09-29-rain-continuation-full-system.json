  "protocol": "Test an uncondensed734-row Newton system at the same38 capped Krylov-driven states. Free rows are original Hff/Hfr divided by Hff diagonal; remaining rows use original natural projection derivative with reduced step sizes and lambda, before elimination. RHS free=0, remaining=-F. Exact elimination recovers previous500-row D; verify algebra <=1e-9. Float32 action uses J M J^T+G without any bilateral inverse. Owner-tuple block preconditioner comes from float64 local pseudoinverses cast to float32, an explicit setup limitation. GMRES restart32/max4cycles/rtol1e-6/atol1e-12/actioncap160 unchanged. Require original float64 full-system residual <=max(1e-12,1e-6*norm(rhs)). No parameter retries, no physical equation change. Keep all previous condensed failures. Diagnostic solves do not alter successful float64 trajectory.\n",
  "sources": {
    "run.py": "from pathlib import Path\np=Path(__file__).resolve().parent\nsetup=(p.parent/'rain-continuation-krylov/audit.py').read_text().split(\"source=(p.parent/'rain-projected-continuation/run.py')\")[0]\nsetup=setup.replace(\"print('KRYLOV',records[-1],flush=True)\",\"print('KRYLOV',records[-1],flush=True);return x if passed else None\")\nexec(compile(setup,str(p/'operator64.py'),'exec'))\nproj=setup[setup.index('def jac_action('):setup.index('records=[]')].replace('def jac_action(','def projection_parts(').replace('return lambda v:(1+lam)*v-P@(v-steps*Schur(v))-C@v','return P,C,steps')\nexec(compile(proj,str(p/'projection.py'),'exec'))\nJ32=m.J.astype(np.float32);M32=m.M.astype(np.float32);G32=m.G.astype(np.float32)\nfullgroups={k:list(r.remaining[ii]) for k,ii in pre_groups.items()}\nfor g in ownership['groups']:fullgroups.setdefault((g['owner'],),[]).extend(r.free[g['free_rows']])\nscale=1/np.diag(r.Hff);rngfull=np.random.default_rng(20261009);full_records=[]\ndef checkfull(y,lam,F,D):\n P,C,steps=projection_parts(y,lam);B=csr_matrix((1+lam)*r.E)-P-C;T=P.multiply(steps[None,:]);A=np.zeros((m.offset,m.offset));A[r.free]=scale[:,None]*m.H[r.free];A[r.remaining]=T@m.H[r.remaining];A[np.ix_(r.remaining,r.remaining)]+=B.toarray()\n v=rngfull.normal(size=r.N);full=np.zeros(m.offset);full[r.remaining]=v;full[r.free]=r.response@v;out=A@full;control=float(max(max(abs(out[r.free])),max(abs(out[r.remaining]-D@v)/(1+abs(D@v)))));assert control<=1e-9\n B32=B.astype(np.float32);T32=T.astype(np.float32);scale32=scale.astype(np.float32)\n def action(v):\n  g=J32@(M32@(J32.T@v))+G32@v;out=np.empty(m.offset,dtype=np.float32);out[r.free]=scale32*g[r.free];out[r.remaining]=B32@v[r.remaining]+T32@g[r.remaining];return out\n local=[(np.array(ii),np.linalg.pinv(A[np.ix_(ii,ii)],rcond=1e-12).astype(np.float32)) for ii in fullgroups.values()]\n def pre(v):\n  out=np.zeros_like(v,dtype=np.float32)\n  for ii,inv in local:out[ii]=inv@v[ii]\n  return out\n rhs=np.zeros(m.offset);rhs[r.remaining]=-F;count=0\n def mv(v):\n  nonlocal count\n  count+=1\n  if count>160:raise RuntimeError('action-cap')\n  return action(v)\n try:\n  x,info=gmres(LinearOperator((m.offset,m.offset),matvec=mv,dtype=np.float32),rhs.astype(np.float32),M=LinearOperator((m.offset,m.offset),matvec=pre,dtype=np.float32),restart=32,maxiter=4,rtol=1e-6,atol=1e-12)\n  residual=float(np.linalg.norm(A@x.astype(float)-rhs));passed=residual<=max(1e-12,1e-6*np.linalg.norm(rhs))\n except RuntimeError:info='action-cap';residual=None;passed=False\n full_records.append(dict(lam=lam,actions=count,info=info,original_absolute_residual=residual,rhs_norm=float(np.linalg.norm(rhs)),linear_pass=bool(passed),elimination_control=control));print('FULL',full_records[-1],flush=True)\nsource=(p.parent/'rain-projected-continuation/run.py').read_text().replace(\"for name,seed in [('cold',np.zeros(r.N)),('capped',m.old[r.remaining].copy())]:\",\"for name,seed in [('capped',m.old[r.remaining].copy())]:\")\nold=\"D=r.residual(y,True)+lam*r.E;delta,_,rank,_=np.linalg.lstsq(D,-F,rcond=1e-12);accepted=False\"\nnew=\"\"\"D=r.residual(y,True)+lam*r.E;delta=audit(y,lam,F,D);checkfull(y,lam,F,D);rank=-1;accepted=False\n   if delta is None:termination='linear-budget-failed';break\"\"\"\nassert old in source;source=source.replace(old,new).split(\"if not all(v['status']=='reference-pass'\")[0];exec(compile(source,str(p/'nonlinear64.py'),'exec'))\nresult=dict(systems=len(full_records),failed=sum(not v['linear_pass'] for v in full_records),preconditioner_sizes=[len(v) for v in fullgroups.values()],records=full_records);(p/'full-audit.json').write_text(json.dumps(result,indent=2));print('SUMMARY',json.dumps({k:v for k,v in result.items() if k!='records'}),flush=True)\n"
